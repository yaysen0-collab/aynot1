{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "number" },
        "modules": { "type": "array" }
      },
      "required": ["uid", "name", "createdAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "birthDate": { "type": "string" },
        "group": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "healthAlert": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "group", "createdAt", "updatedAt"]
    },
    "StudentNote": {
      "title": "StudentNote",
      "description": "Notes for students or general school notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "title": { "type": "string" },
        "tag": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "date", "category", "content", "createdAt", "updatedAt"]
    },
    "ParentCallSession": {
      "title": "ParentCallSession",
      "description": "Weekly parent call logs and notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "weekDate": { "type": "string" },
        "status": { "type": "string" },
        "calls": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "weekDate", "status", "calls", "createdAt", "updatedAt"]
    },
    "StudyTask": {
      "title": "StudyTask",
      "description": "Personal and academic study tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "targetDurationMinutes": { "type": "number" },
        "date": { "type": "string" },
        "dayOfWeek": { "type": "number" },
        "courseId": { "type": "string" },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "number" },
        "pomodoroCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "type", "completed", "createdAt", "updatedAt"]
    },
    "StudyDayConfig": {
      "title": "StudyDayConfig",
      "description": "Day type settings (okul gunu, bos gun)",
      "type": "object",
      "properties": {
        "dayOfWeek": { "type": "number" },
        "dayType": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["dayOfWeek", "dayType"]
    },
    "DayCheckin": {
      "title": "DayCheckin",
      "description": "Evening fatigue level check-in",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "level": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["date", "level"]
    },
    "EnglishNote": {
      "title": "EnglishNote",
      "description": "Grammar and vocabulary notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "tag": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "content", "createdAt", "updatedAt"]
    },
    "EnglishDeck": {
      "title": "EnglishDeck",
      "description": "Flashcard decks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "createdAt", "updatedAt"]
    },
    "EnglishCard": {
      "title": "EnglishCard",
      "description": "Vocabulary flashcard with spaced repetition data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deckId": { "type": "string" },
        "front": { "type": "string" },
        "back": { "type": "string" },
        "example": { "type": "string" },
        "level": { "type": "number" },
        "nextReviewDate": { "type": "string" },
        "learnedDate": { "type": "string" },
        "reviewCount": { "type": "number" },
        "lapseCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "deckId", "front", "back", "level", "createdAt", "updatedAt"]
    },
    "EnglishReviewLog": {
      "title": "EnglishReviewLog",
      "description": "Daily flashcard review progress log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cardId": { "type": "string" },
        "date": { "type": "string" },
        "quality": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "cardId", "date", "quality", "createdAt"]
    },
    "UniversityTerm": {
      "title": "UniversityTerm",
      "description": "Academic semester term",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "isActive", "createdAt", "updatedAt"]
    },
    "UniversityCourse": {
      "title": "UniversityCourse",
      "description": "University course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "termId": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "instructor": { "type": "string" },
        "credits": { "type": "number" },
        "color": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "termId", "name", "createdAt", "updatedAt"]
    },
    "UniversityExam": {
      "title": "UniversityExam",
      "description": "Exam schedule and weighting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "weight": { "type": "number" },
        "score": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "courseId", "title", "type", "date", "createdAt", "updatedAt"]
    },
    "UniversityNote": {
      "title": "UniversityNote",
      "description": "Lecture and study notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "week": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "courseId", "title", "content", "createdAt", "updatedAt"]
    },
    "UniversityAssignment": {
      "title": "UniversityAssignment",
      "description": "Homework and projects",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "dueDate": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "courseId", "title", "completed", "createdAt", "updatedAt"]
    },
    "ProjectIdea": {
      "title": "ProjectIdea",
      "description": "Creative project and startup ideas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "status", "priority", "createdAt", "updatedAt"]
    },
    "PersonalNote": {
      "title": "PersonalNote",
      "description": "Quick notes, links, code snippets and ideas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "tagIds": { "type": "array" },
        "pinned": { "type": "boolean" },
        "color": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "content", "createdAt", "updatedAt"]
    },
    "PersonalTag": {
      "title": "PersonalTag",
      "description": "User created tags for personal notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "name", "color"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Application settings entry",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "object" }
      },
      "required": ["key"]
    },
    "Photo": {
      "title": "Photo",
      "description": "Compressed photo document (under 200KB)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dataUrl": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "dataUrl", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/profile/{profileId}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/users/{userId}/students/{studentId}": {
      "schema": "Student",
      "description": "Students collection"
    },
    "/users/{userId}/student_notes/{noteId}": {
      "schema": "StudentNote",
      "description": "Student and school notes collection"
    },
    "/users/{userId}/parent_call_sessions/{sessionId}": {
      "schema": "ParentCallSession",
      "description": "Weekly parent call sessions"
    },
    "/users/{userId}/study_tasks/{taskId}": {
      "schema": "StudyTask",
      "description": "Study tasks"
    },
    "/users/{userId}/study_day_configs/{configId}": {
      "schema": "StudyDayConfig",
      "description": "Daily study config"
    },
    "/users/{userId}/day_checkins/{checkinId}": {
      "schema": "DayCheckin",
      "description": "Evening fatigue checkin"
    },
    "/users/{userId}/english_notes/{noteId}": {
      "schema": "EnglishNote",
      "description": "English study notes"
    },
    "/users/{userId}/english_decks/{deckId}": {
      "schema": "EnglishDeck",
      "description": "English decks"
    },
    "/users/{userId}/english_cards/{cardId}": {
      "schema": "EnglishCard",
      "description": "English cards"
    },
    "/users/{userId}/english_review_logs/{logId}": {
      "schema": "EnglishReviewLog",
      "description": "English card review logs"
    },
    "/users/{userId}/university_terms/{termId}": {
      "schema": "UniversityTerm",
      "description": "University terms"
    },
    "/users/{userId}/university_courses/{courseId}": {
      "schema": "UniversityCourse",
      "description": "University courses"
    },
    "/users/{userId}/university_exams/{examId}": {
      "schema": "UniversityExam",
      "description": "University exams"
    },
    "/users/{userId}/university_notes/{noteId}": {
      "schema": "UniversityNote",
      "description": "University notes"
    },
    "/users/{userId}/university_assignments/{assignmentId}": {
      "schema": "UniversityAssignment",
      "description": "University assignments"
    },
    "/users/{userId}/project_ideas/{ideaId}": {
      "schema": "ProjectIdea",
      "description": "Project ideas"
    },
    "/users/{userId}/personal_notes/{noteId}": {
      "schema": "PersonalNote",
      "description": "Personal notes"
    },
    "/users/{userId}/personal_tags/{tagId}": {
      "schema": "PersonalTag",
      "description": "Personal tags"
    },
    "/users/{userId}/settings/{settingKey}": {
      "schema": "Setting",
      "description": "User specific settings"
    },
    "/users/{userId}/photos/{photoId}": {
      "schema": "Photo",
      "description": "Compressed photos"
    }
  }
}
