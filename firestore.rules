rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure all user-scoped data strictly to the authenticated owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
